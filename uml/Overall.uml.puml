' ================= NAMESPACE: ENEMIES =================
package "enemies" {
    abstract class Enemy {
        # enemyManager: EnemyManager
        # x: float
        # y: float
        # bounds: Rectangle
        # health: int
        # maxHealth: int
        # ID: int
        # enemyType: int
        # lastDir: int
        # alive: boolean = true
        # slowTickLimit: int = 120
        # slowTick: int = 120

        + Enemy(x: float, y: float, ID: int, enemyType: int, enemyManager: EnemyManager)
        + setStartHealth(): void
        + hurt(damage: int): void
        + slow(): void
        + kill(): void
        + move(speed: float, dir: int): void
        - updateHitbox(): void
        + setPos(x: int, y: int): void
        + getHealthBarFloat(): float
        + getX(): float
        + getY(): float
        + getID(): int
        + getEnemyType(): int
        + getHealth(): int
        + getBounds(): Rectangle
        + getLastDir(): int
        + isAlive(): boolean
        + isSlowed(): boolean
    }

    class ENEMY1 {
        + ENEMY1(x: float, y: float, ID: int, enemyManager: EnemyManager)
    }

    class ENEMY2 {
        + ENEMY2(x: float, y: float, ID: int, enemyManager: EnemyManager)
    }

    class ENEMY3 {
        + ENEMY3(x: float, y: float, ID: int, enemyManager: EnemyManager)
    }

    class ENEMY4 {
        + ENEMY4(x: float, y: float, ID: int, enemyManager: EnemyManager)
    }

    Enemy <|-- ENEMY1
    Enemy <|-- ENEMY2
    Enemy <|-- ENEMY3
    Enemy <|-- ENEMY4
}

