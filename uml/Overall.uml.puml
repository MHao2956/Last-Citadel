' ================= NAMESPACE: MAIN =================
package "main" {
    class Game {
        - gameScreen: GameScreen
        - gameThread: Thread
        - FPS_SET: double = 120.0
        - UPS_SET: double = 60.0
        - render: Render
        - menu: Menu
        - playing: Playing
        - settings: Settings
        - editing: Editing
        - tileManager: TileManager
        - gameOver: GameOver
        + Game()
        - createDefaultLevel(): void
        - initClasses(): void
        - start(): void
        - updateGame(): void
        + main(args: String[]): void
        + run(): void
        + getRender(): Render
        + getMenu(): Menu
        + getPlaying(): Playing
        + getSettings(): Settings
        + getEditor(): Editing
        + getTileManager(): TileManager
        + getGameOver(): GameOver
    }

    class GameScreen {
        - game: Game
        - size: Dimension
        - myMouseListener: MyMouseListener
        - keyboardListener: KeyboardListener
        + GameScreen(game: Game)
        + initInputs(): void
        - setPanelSize(): void
        + paintComponent(g: Graphics): void
    }

    enum GameStates {
        PLAYING
        MENU
        SETTINGS
        EDIT
        GAME_OVER
        + gameState: GameStates = MENU
        + SetGameState(state: GameStates): void
    }

    class Render {
        - game: Game
        + Render(game: Game)
        + render(g: Graphics): void
    }
}

